{
  "name": "family-hustle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hub": "tsc --noEmit && FH_TARGET=hub vite build && node scripts/pack-hub.mjs",
    "build:server": "esbuild server/sync-server.ts --bundle --platform=node --format=esm --outfile=dist-server/sync-server.mjs --log-level=warning",
    "sync:dev": "npm run build:server && node scripts/sync-dev.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:recurrence && npm run test:roster && npm run test:sync",
    "test:roster": "esbuild scripts/roster-import.test.ts --bundle --platform=node --format=esm --outfile=.test-build/roster.mjs --log-level=warning && node .test-build/roster.mjs",
    "test:recurrence": "esbuild scripts/recurrence.test.ts --bundle --platform=node --format=esm --outfile=.test-build/recurrence.mjs --log-level=warning && TZ=Pacific/Auckland node .test-build/recurrence.mjs",
    "test:sync": "esbuild scripts/sync-contract.test.ts --bundle --platform=node --format=esm --outfile=.test-build/sync.mjs --log-level=warning && node .test-build/sync.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
